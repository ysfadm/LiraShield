# Stellar network endpoints (Testnet defaults — safe to keep as-is)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployed testnet contract / token addresses used by the current demo
NEXT_PUBLIC_LIRASHIELD_VAULT_CONTRACT_ID=CBPFONSUFARVHCLU23GPRVRWA5VREEEBDZYB2DR42MGJEJITZLOUU7BT
NEXT_PUBLIC_TRY_TOKEN_CONTRACT_ID=CDLR5NMVHRM2KYYZ5C774EV4U3PYBSYSGSNYCHKREYX2TZP6337CGHGL
NEXT_PUBLIC_USDC_TOKEN_CONTRACT_ID=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
NEXT_PUBLIC_SOROSWAP_ROUTER_CONTRACT_ID=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD
NEXT_PUBLIC_DEFINDEX_VAULT_CONTRACT_ID=CBMVK2JK6NTOT2O4HNQAIQFJY232BHKGLIMXDVQVHIIZKDACXDFZDWHN

# Passkey smart-wallet WASM hash (see passkey-kit docs for the current testnet hash)
NEXT_PUBLIC_WALLET_WASM_HASH=97ce047884106b1c6c3bb40b8973cc48db1c4dad95c9e20462bf2c701daa764e

# Anchor / SEP-1, SEP-10, SEP-6, SEP-38 TRY <-> USDC fiat rail.
# "live" (default) talks to the real TR Mock Anchor (tr-mock-anchor.fly.dev),
# a hosted SEP-6 sandbox verified with SDF's anchor-tests: bank/KYC are
# simulated, but SEP-10 auth and the on-chain USDC leg are real testnet.
# "mock" falls back to our own /api/mock-anchor/* routes if the anchor is
# unreachable during a demo (e.g. no internet at the venue).
NEXT_PUBLIC_ANCHOR_MODE=live
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---

# Mock USDC issuer secret and SAC contract ID, used only by the mock deposit
# route. Keep the secret server-only; never prefix it with NEXT_PUBLIC_.
MOCK_USDC_ISSUER_SECRET=
MOCK_USDC_TOKEN_CONTRACT_ID=
MOCK_ANCHOR_MAX_TRY_AMOUNT=1000000

# OpenZeppelin Relayer Channels credentials for fee-sponsored passkey transactions.
# https://docs.openzeppelin.com/relayer/stellar
RELAYER_BASE_URL=
RELAYER_API_KEY=
ALLOW_WALLET_CREATION_RELAY=true
# Optional G... public key of the canonical passkey wallet deployer.
PASSKEY_DEPLOYER_PUBLIC_KEY=
# Relay protection defaults: 30 requests per minute and a 200 KB request body.
RELAYER_RATE_LIMIT_MAX_REQUESTS=30
RELAYER_RATE_LIMIT_WINDOW_MS=60000
RELAYER_MAX_BODY_BYTES=200000
# Comma-separated Soroban contract IDs allowed for assembled transaction relay.
# Keep this limited to LiraShield's vault and the exact SAC/router contracts used by the app.
RELAYER_ALLOWED_CONTRACT_IDS=CBPFONSUFARVHCLU23GPRVRWA5VREEEBDZYB2DR42MGJEJITZLOUU7BT,CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU,CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD
